{
  "manifest_version": 3,
  "name": "Contextify - AI Web Learning Assistant",
  "version": "1.0.0",
  "description": "Select any text on a webpage and get instant AI-powered explanations without leaving the page.",

  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],

  "host_permissions": [
    "http://localhost:5000/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}